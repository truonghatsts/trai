# Supabase project (jobs + transcripts migrations applied, one Auth user created)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Speech-to-text provider (research #5). Only "openai" is implemented; the
# provider is swappable via this var.
STT_PROVIDER=openai
OPENAI_API_KEY=

# yt-dlp binary (research #4). Leave default if on PATH in the worker image.
YTDLP_PATH=yt-dlp

# HTTP
PORT=3000
