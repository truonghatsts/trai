{
  "name": "video-transcription-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/build-auth.mjs && tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/build-auth.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build-auth.mjs",
    "test": "vitest run",
    "lint": "eslint src tests",
    "migrate": "supabase db push"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@supabase/supabase-js": "^2.45.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.0"
  }
}
