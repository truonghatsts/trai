{
  "manifest_version": 3,
  "name": "TRAI",
  "version": "0.1.0",
  "description": "Transcribe public videos into plain text on demand.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/video-detect.js"],
      "run_at": "document_idle"
    }
  ]
}