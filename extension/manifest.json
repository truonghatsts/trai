{
  "manifest_version": 3,
  "name": "Video Transcript",
  "version": "0.1.0",
  "description": "Transcribe public videos into plain text on demand.",
  "action": {},
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/video-detect.js"],
      "run_at": "document_idle"
    }
  ]
}