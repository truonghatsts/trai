# Extension config, read by build.mjs at build time (values are inlined).
# Copy to .env and fill in.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Must match a manifest.json host_permissions pattern (default local dev URL,
# or a Railway service URL https://<service>.up.railway.app). Custom domains:
# add the pattern to extension/manifest.json host_permissions and rebuild.
BACKEND_URL=http://localhost:3000